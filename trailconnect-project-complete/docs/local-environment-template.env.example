# Local development template only — never commit actual values.
NODE_ENV=development
PORT=3000

# MySQL or MariaDB connection string, with TLS in production.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Generate a long, random secret for signed session cookies.
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth. Console → APIs & Services → Credentials → OAuth client ID.
# Authorised redirect URI must be exactly: ${APP_URL}/api/oauth/callback
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-server-only-secret

# externalId of the account promoted to administrator on sign-in.
# With Google this is "google:<sub>" — sign in once, then read it from the
# `users` table and set it here.
OWNER_EXTERNAL_ID=your-owner-external-id

# Where covers, avatars, post images and GPX/KML tracks are written.
UPLOAD_DIR=./var/uploads

# Maps (client-side, baked into the bundle at build time).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Stripe is optional until the guided-outing payment flow is completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
