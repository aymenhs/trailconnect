# TrailConnect — configuration
#
# Copy to `.env` and fill in. Never commit `.env`.
# Values below are placeholders, not real secrets.

# ── Core ──────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Must match the port in the Caddy site block. If this one is busy at startup
# the server silently takes the next free one (3001…3019) while the proxy keeps
# pointing here — which surfaces as an unexplained 502. On a shared machine,
# check with deploy/preflight.sh and pick a free port.
PORT=3000

# Public origin. Used to build the OAuth callback URL and absolute links.
# Must match exactly what the browser sees, scheme included.
APP_URL=https://trailconnect.example.com

# Identifies sessions issued by this deployment. A session carrying a different
# appId is rejected, so two deployments sharing a JWT secret stay separate.
APP_ID=trailconnect

# ── Database ──────────────────────────────────────────────────────────────────

# MySQL 8 or MariaDB 10.6+. Create the schema with `pnpm run db:push`.
#
# Business dates are naive DATETIME, so the connection has to be UTC. Append
# `?timezone=Z` when the server's own time_zone is not UTC — it pins this
# connection only, leaving a shared database server's global setting alone.
DATABASE_URL=mysql://trailconnect:CHANGE_ME@127.0.0.1:3306/trailconnect?timezone=Z

# ── Sessions ──────────────────────────────────────────────────────────────────

# Signs the session JWT. Generate with: openssl rand -base64 48
# Rotating it signs everyone out — which is the point when it may have leaked.
JWT_SECRET=CHANGE_ME

# Set to "none" only if the app must run embedded cross-site in an iframe.
# It forces the Secure flag, and weakens CSRF protection. Leave unset otherwise.
# SESSION_COOKIE_SAMESITE=lax

# ── Authentication (Google OAuth) ─────────────────────────────────────────────
#
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorised redirect URI must be exactly:
#   ${APP_URL}/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# externalId of the account promoted to administrator on sign-in.
# With Google this is "google:<sub>" — sign in once, then read it from the
# `users` table and set it here.
OWNER_EXTERNAL_ID=

# ── Uploads ───────────────────────────────────────────────────────────────────

# Where covers, avatars, post images and GPX/KML tracks are written.
# Back this directory up: it is not reconstructible from the database.
UPLOAD_DIR=/var/lib/trailconnect/uploads

# ── Scheduled tasks ───────────────────────────────────────────────────────────

# Shared secret for /api/scheduled/*. Generate with: openssl rand -hex 32
# Call from a systemd timer or cron:
#   curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     "$APP_URL/api/scheduled/finalize-account-deletions"
CRON_SECRET=CHANGE_ME

# ── Maps (client-side, baked into the bundle at build time) ───────────────────

# A browser key is public by nature. Restrict it by HTTP referrer to your
# domain in the Google Cloud console — that restriction is what protects it.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID from your own Google Cloud project. Without it the app falls back to
# Google's DEMO_MAP_ID, which is rate limited and logs warnings.
VITE_GOOGLE_MAP_ID=

# ── Analytics (optional, client-side) ─────────────────────────────────────────
#
# Self-hosted Umami. Nothing loads until the visitor consents.
# Leave both empty to disable analytics entirely — the consent banner then
# never appears.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
